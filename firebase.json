            }
          ]
        },
        {
          "source": "/Parcha-Clinic-Setup.exe",
          "headers": [
            {
              "key": "Content-Type",
              "value": "application/octet-stream"
            },
            {
              "key": "Content-Disposition",
              "value": "attachment; filename=\"Parcha-Clinic-Setup.exe\""
            },
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ]
    },
    {
      "target": "old-clinic",
      "public": "apps/downloads/redirect",
      "redirects": [
        {
          "source": "**",
          "destination": "https://parcha-clinic.web.app",
          "type": 301
        }
      ]
    }
