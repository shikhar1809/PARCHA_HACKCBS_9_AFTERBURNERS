{
  "name": "parcha",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "seed": "node scripts/seed.mjs",
    "dev:patient": "npm run dev --workspace @parcha/patient",
    "dev:clinic": "npm run dev --workspace @parcha/clinic",
    "emulators": "node scripts/emulators.mjs",
    "functions:build": "npm run build --workspace @parcha/functions",
    "test": "tsx --test packages/core/test/*.test.ts",
    "test:integration": "node --test --test-concurrency=1 scripts/integration.test.mjs",
    "check": "npm run typecheck:apps && npm run functions:build",
    "typecheck:apps": "tsc -p apps/clinic --noEmit && tsc -p apps/patient --noEmit",
    "build:live": "npm run build:live --workspace @parcha/clinic && npm run build:live --workspace @parcha/patient",
    "deploy:live": "npm run build:live && npm run functions:build && firebase deploy --project live"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "firebase/functions"
  ]
}
