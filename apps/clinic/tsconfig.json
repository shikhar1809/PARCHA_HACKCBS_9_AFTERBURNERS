{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@parcha/core": [
        "../../packages/core/src/index.ts"
      ],
      "@parcha/ui": [
        "../../packages/ui/src/index.ts"
      ],
      "@parcha/client": [
        "../../packages/client/src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts",
    "../../packages/core/src",
    "../../packages/ui/src",
    "../../packages/client/src"
  ]
}
