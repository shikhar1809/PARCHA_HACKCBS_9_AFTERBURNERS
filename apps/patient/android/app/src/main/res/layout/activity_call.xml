<?xml version="1.0" encoding="utf-8"?>
<!--
  The incoming-call screen, drawn natively rather than in the web view.

  Natively, because this has to appear instantly over a lock screen with the
  app not running at all: booting a browser first would turn a ringing phone
  into a blank one. So it is plain Android views, in Parcha's own colours, with
  the two targets big enough for somebody who is half asleep.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF7F0"
    android:gravity="center_horizontal"
    android:padding="24dp">

    <TextView
        android:id="@+id/call_from"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#6B5B52"
        android:text="Parcha" />

    <TextView
        android:id="@+id/call_who"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:gravity="center"
        android:textSize="34sp"
        android:textStyle="bold"
        android:textColor="#232326"
        android:text="" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#FFE3D3"
        android:padding="22dp">

        <!-- The strip she photographed: the one in her hand to take. -->
        <ImageView
            android:id="@+id/call_strip"
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:layout_marginBottom="14dp"
            android:scaleType="centerCrop"
            android:contentDescription="Strip"
            android:visibility="gone" />

        <TextView
            android:id="@+id/call_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#232326"
            android:text="" />

        <TextView
            android:id="@+id/call_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textSize="20sp"
            android:textColor="#4A3F38"
            android:text="" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Three answers. The two about the dose sit side by side, each a thumb
         wide; the message is the whole width below, so it is never pressed
         when "taken" was meant. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2">

        <Button
            android:id="@+id/call_later"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="88dp"
            android:layout_marginEnd="10dp"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#232326"
            android:background="#FFD28A"
            android:text="Not taken" />

        <Button
            android:id="@+id/call_taken"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="88dp"
            android:layout_marginStart="10dp"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="#2E9E5B"
            android:text="Taken" />
    </LinearLayout>

    <Button
        android:id="@+id/call_record"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_marginTop="14dp"
        android:textSize="19sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="#FF7F5A"
        android:text="Record a message" />

    <TextView
        android:id="@+id/call_record_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="36dp"
        android:gravity="center"
        android:textSize="15sp"
        android:textColor="#4A3F38"
        android:text="" />
</LinearLayout>
