# The live Firebase project. Used by: vite build --mode parcha-101
# A Firebase web config is public by design; the security rules and the
# Cloud Functions are what protect the data.
VITE_FIREBASE_USE_EMULATORS=false
VITE_FIREBASE_PROJECT_ID=parcha-101
VITE_FIREBASE_API_KEY=AIzaSyDXUdMy8wgEWFE8BJkQlVuujCr46pH5azA
VITE_FIREBASE_AUTH_DOMAIN=parcha-101.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=parcha-101.firebasestorage.app
VITE_FIREBASE_SENDER_ID=393156134237
VITE_FIREBASE_APP_ID=1:393156134237:web:78d03db059a2e57fb714b4

# One tap on a seeded demo handset signs in without SMS (needs DEMO_SIGN_IN=on for the functions).
VITE_DEMO_SIGN_IN=on
